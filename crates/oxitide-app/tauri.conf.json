{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OxiTide",
  "identifier": "org.codeberg.zephulbr.oxitide",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../ui" }
  },
  "app": {
    "windows": [
      { "title": "OxiTide", "width": 1200, "height": 800, "minWidth": 720, "minHeight": 520, "dragDropEnabled": false, "visible": false, "generalAutofillEnabled": false }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://resources.tidal.com",
        "media-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://resources.tidal.com",
        "media-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["tidal"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEMzU3MkY5NzdFN0I2N0UKUldSK3R1ZDMrWEkxelp3K2tXQ0NxaStaYU4rVVlIa1lyVXVXSGtIN1VoaFRKNGtlbTJhTkVoUHgK",
      "endpoints": ["https://github.com/Zephulbr/OxiTide/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "OxiTide",
    "copyright": "AGPL-3.0-or-later",
    "category": "Music",
    "shortDescription": "Unofficial TIDAL desktop client",
    "longDescription": "OxiTide is an unofficial TIDAL desktop client for Windows with bit-perfect playback, a streaming cache, and a native Tauri UI.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
