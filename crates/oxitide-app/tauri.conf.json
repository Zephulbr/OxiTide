{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OxiTide",
  "version": "0.2.0",
  "identifier": "org.codeberg.zephulbr.oxitide",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../ui" }
  },
  "app": {
    "windows": [
      { "title": "OxiTide", "width": 1200, "height": 800, "minWidth": 720, "minHeight": 520, "dragDropEnabled": false, "visible": false }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["tidal"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "OxiTide",
    "copyright": "AGPL-3.0-or-later",
    "category": "Music",
    "shortDescription": "Unofficial TIDAL desktop client",
    "longDescription": "OxiTide is an unofficial TIDAL desktop client for Windows with bit-perfect playback, a streaming cache, and a native Tauri UI.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
