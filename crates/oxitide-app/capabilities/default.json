{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://login.tidal.com/*" },
        { "url": "https://tidal.com/*" },
        { "url": "https://www.last.fm/api/auth/*" },
        { "url": "https://listenbrainz.org/profile/*" },
        { "url": "https://github.com/adryd325/oneko.js" },
        { "url": "https://github.com/kyrie25/spicetify-oneko" }
      ]
    }
  ]
}
